<?php
// Static shell only — no store access here at all. The table starts empty
// and is filled by a POST to scripts/store_api.php on load, which is also
// the only place that ever reads or writes the store. See CLAUDE.md
// "Phase 3" for why (single renderer, reused for every mutation).
$pluginRoot = '/plugins/unraid-secretsman';
?>
<link type="text/css" rel="stylesheet" href="<?php autov('/webGui/styles/jquery.filetree.css') ?>">
<script src="<?php autov('/webGui/javascript/jquery.filetree.js') ?>" charset="utf-8"></script>
<p>
  A password or API key typed into a Docker template's Variable field is written in plaintext
  to flash, shows up in the <code>docker run</code> command the GUI displays back to you, and
  ends up in every flash backup and anything you paste (a forum post, a support chat) from
  then on. This page stores secrets once, outside flash, and lets a template hold a token
  instead of the real value.
</p>
<p>
  <strong>To use it:</strong> add a secret below, click its <strong>Copy token</strong>
  button, then paste that — <code>!secret &lt;namespace&gt;/&lt;key&gt;</code>, for example
  <code>!secret myapp/api_key</code> — into the template's Variable field <strong>in place of
  the value</strong>, and Apply as normal. At container-create time this plugin resolves the
  token against the store below and hands the container the real value through the normal
  Docker mechanism — the container receives it exactly as if you'd typed it in directly, and
  can't tell the difference. Only the template, and anything derived from it, ever sees the
  token instead of the value.
  <span id="sm-help-toggle" style="cursor:help" title="More detail">(?)</span>
</p>
<blockquote class="inline_help">
  Namespace and key may contain only letters, digits, and <code>_ . -</code> — the add form
  enforces this, and the same rule applies if you type a token into a template by hand.
  <br><br>
  <strong>What this does not protect against:</strong> the resolved value is still a real
  environment variable inside the running container, so it remains visible to <code>docker
  inspect</code> and <code>/proc/&lt;pid&gt;/environ</code>. Both already require root or
  docker-socket access to the host — and with that access, the store file below is just as
  readable directly. This page closes the exposures that <em>leave</em> the host (flash
  backups, a template pasted somewhere, the displayed command); it does not add a second lock
  on a door that access already opens.
  <br><br>
  The store itself lives at <code>/mnt/user/appdata/.secrets/store.json</code>, outside flash,
  <code>root:root 0600</code> — it is not encrypted at rest, so protect it the way you would
  any file holding plaintext credentials.
</blockquote>

<form id="sm-add" onsubmit="return false">
  <table class="tablesorter shift">
    <thead><tr><th>Add a secret</th></tr></thead>
  </table>
  <table class="new">
    <tr>
      <td>Namespace</td>
      <td><input type="text" id="sm-ns" class="narrow" required pattern="[A-Za-z0-9_.-]+" placeholder="myapp"></td>
      <td>Key</td>
      <td><input type="text" id="sm-key" class="narrow" required pattern="[A-Za-z0-9_.-]+" placeholder="api_key"></td>
      <td>Value</td>
      <td>
        <span style="display:inline-flex;align-items:center;gap:0.5em">
          <input type="password" id="sm-val" required autocomplete="new-password">
          <label style="white-space:nowrap"><input type="checkbox" id="sm-show"> show</label>
        </span>
      </td>
      <td><button id="sm-addbtn" type="button">Add</button></td>
    </tr>
  </table>
  <span id="sm-adderr" class="errortext"></span>
</form>

<div id="sm-table"><p class="notice">Loading&hellip;</p></div>

<table class="tablesorter shift">
  <thead><tr><th>Backup &amp; Restore</th></tr></thead>
</table>
<div id="sm-backup"><p class="notice">Loading&hellip;</p></div>

<script>
(function($){
'use strict';
var API = '<?=$pluginRoot?>/scripts/store_api.php';
var BACKUP_API = '<?=$pluginRoot?>/scripts/backup_api.php';

// Was a static .notice div — Unraid's stock .notice styling is a fixed
// warning-triangle look, identical for success and failure, which is why
// every result looked the same regardless of outcome. swal is already
// loaded and already used on this page (the restore confirmation dialog);
// its built-in success/error types give a real green-tick/red-cross
// distinction and a click-to-dismiss popup for free, matching the
// CA-style notice convention, with no new dependency.
function banner(msg, isError) {
  if (!msg) { return; }
  try {
    if (window.swal) {
      swal({ title: isError ? 'Error' : 'Success', text: msg, type: isError ? 'error' : 'success', confirmButtonText: 'OK' });
      return;
    }
  } catch (e) {
    // fall through — a restore result silently vanishing is exactly the
    // failure mode this project keeps getting burned by; never let a
    // library quirk reproduce it a fourth time.
  }
  alert(msg);
}

function refresh(html) {
  $('#sm-table').html(html);
}

function handleJsonResult(resp, done) {
  if (!resp || resp.ok !== true) {
    banner((resp && resp.error) || 'secretsman: request failed', true);
    return;
  }
  banner('');
  done(resp);
}

function postTo(url, data, done) {
  $.post(url, data, function (resp) { handleJsonResult(resp, done); }, 'json').fail(function () {
    banner('secretsman: request failed — check the browser console', true);
  });
}

function post(action, data, done) {
  data = data || {};
  data.action = action;
  postTo(API, data, done);
}

function postBackup(action, data, done) {
  data = data || {};
  data.action = action;
  postTo(BACKUP_API, data, done);
}

// Archive uploads for restore travel as a base64 field in a plain
// urlencoded POST, not multipart/form-data — this host's nginx
// auth_request subrequest times out on multipart POST regardless of
// target script or session state (confirmed live; see CLAUDE.md). Archives
// here are a few KB at most, so the ~33% base64 overhead is irrelevant,
// and this reuses the same postBackup()/$.post path every other action on
// this page already proves works.
var uploadLimitBytes = 0;

function load() {
  post('list', {}, function (resp) { refresh(resp.html); });
}

// Same table refresh as load(), but never touches the banner. load() goes
// through handleJsonResult(), which unconditionally clears the banner the
// instant ITS OWN response lands — fine when it's the only in-flight
// request, but restore fires this table refresh alongside its own
// success banner, and the two responses race. Whichever lands second wins,
// so load()'s response can (and did, live) wipe the restore result message
// within milliseconds of it appearing.
function refreshTableOnly() {
  $.post(API, { action: 'list' }, function (resp) {
    if (resp && resp.ok) { refresh(resp.html); }
  }, 'json');
}

// Copies the TOKEN ("!secret ns/key"), never a value — the safe button.
function copyToken(ns, key) {
  var text = '!secret ' + ns + '/' + key;
  if (navigator.clipboard && window.isSecureContext) {
    navigator.clipboard.writeText(text);
    return;
  }
  var ta = document.createElement('textarea');
  ta.value = text;
  ta.style.position = 'fixed';
  ta.style.opacity = '0';
  document.body.appendChild(ta);
  ta.select();
  try { document.execCommand('copy'); } catch (e) {}
  document.body.removeChild(ta);
}

$('#sm-show').on('change', function () {
  $('#sm-val').attr('type', this.checked ? 'text' : 'password');
});

// Stock expandable-help convention: blockquote.inline_help is hidden by
// global CSS (default-base.css); a clickable element toggles it, same as
// e.g. dynamix/WG0.page does for its own help blocks.
$('#sm-help-toggle').on('click', function () {
  $(this).closest('p').next('blockquote.inline_help').toggle('slow');
});

$('#sm-addbtn').on('click', function () {
  var form = document.getElementById('sm-add');
  if (!form.checkValidity()) { form.reportValidity(); return; }
  var ns = $('#sm-ns').val();
  var key = $('#sm-key').val();
  var val = $('#sm-val').val();
  if (/[\r\n]/.test(val)) {
    $('#sm-adderr').text('Values cannot contain a line break — !secret values reach Docker via --env-file, which cannot carry one safely.');
    return;
  }
  $('#sm-adderr').text('');
  post('add', {ns: ns, key: key, value: val}, function (resp) {
    refresh(resp.html);
    $('#sm-ns').val(''); $('#sm-key').val(''); $('#sm-val').val(''); $('#sm-show').prop('checked', false).trigger('change');
  });
});

$('#sm-table').on('click', '.sm-reveal', function () {
  var $btn = $(this), $row = $btn.closest('tr'), $cell = $row.find('.sm-value');
  if ($btn.text() === 'Hide') {
    $cell.html($cell.data('maskHtml'));
    $btn.text('Reveal');
    return;
  }
  post('reveal', {ns: $row.data('ns'), key: $row.data('key')}, function (resp) {
    $cell.data('maskHtml', $cell.html());
    $cell.text(resp.value);
    $btn.text('Hide');
  });
});

$('#sm-table').on('click', '.sm-copy', function () {
  var $row = $(this).closest('tr');
  copyToken($row.data('ns'), $row.data('key'));
});

$('#sm-table').on('click', '.sm-add-orphan, .sm-orphans button', function () {
  $('#sm-ns').val($(this).data('ns'));
  $('#sm-key').val($(this).data('key'));
  $('#sm-val').focus();
});

$('#sm-table').on('click', '.sm-edit', function () {
  var $row = $(this).closest('tr'), $cell = $row.find('.sm-value');
  $cell.html('<input type="password" class="sm-edit-val narrow"> <button type="button" class="sm-edit-save">Save</button> <button type="button" class="sm-edit-cancel">Cancel</button>');
});

$('#sm-table').on('click', '.sm-edit-cancel', function () {
  load();
});

$('#sm-table').on('click', '.sm-edit-save', function () {
  var $row = $(this).closest('tr');
  var val = $row.find('.sm-edit-val').val();
  if (/[\r\n]/.test(val)) {
    banner('Values cannot contain a line break — !secret values reach Docker via --env-file, which cannot carry one safely.', true);
    return;
  }
  post('edit', {ns: $row.data('ns'), key: $row.data('key'), value: val}, function (resp) {
    refresh(resp.html);
  });
});

$('#sm-table').on('click', '.sm-delete', function () {
  var $row = $(this).closest('tr'), ns = $row.data('ns'), key = $row.data('key');
  var usedBy = $row.find('td:nth-child(2)').text(); // "Used by" column
  var text = 'This will permanently remove ' + ns + '/' + key + ' from the store.';
  if (usedBy && usedBy !== '—') {
    text += ' It is used by: ' + usedBy + ' — those containers will fail to start until it is restored.';
  }
  if (window.swal) {
    swal({
      title: 'Delete ' + ns + '/' + key + '?',
      text: text,
      type: 'warning',
      showCancelButton: true,
      confirmButtonText: 'Delete'
    }, function (ok) {
      if (ok) post('delete', {ns: ns, key: key}, function (resp) { refresh(resp.html); });
    });
  } else if (confirm(text)) {
    post('delete', {ns: ns, key: key}, function (resp) { refresh(resp.html); });
  }
});

function refreshBackup(html) {
  $('#sm-backup').html(html);
}

function loadBackup() {
  postBackup('list', {}, function (resp) {
    refreshBackup(resp.html);
    uploadLimitBytes = resp.uploadLimitBytes || 0;
  });
}

$('#sm-backup').on('change', '#bk-password-show', function () {
  $('#bk-password').attr('type', this.checked ? 'text' : 'password');
});

// Directory picker: $.fn.fileTree is a genuinely global, stock jQuery
// plugin (webGui/javascript/jquery.filetree.js), posting to the shared
// webGui/include/FileTree.php — not appdata.backup-specific, only its
// convenience wrapper around this (ftAttach) is private to that plugin.
// This wires the same stock primitive directly: a folder click sets the
// destination field and closes the tree.
$('#sm-backup').on('click', '#bk-dest-browse', function () {
  var $tree = $('#bk-dest-tree');
  if ($tree.data('loaded')) { $tree.toggle(); return; }
  $tree.data('loaded', true).show().fileTree({
    root: '/mnt/user/',
    script: '/webGui/include/FileTree.php',
    multiFolder: false
  }, function () {
    // file clicked — destination must be a directory, so files are ignored
  }, function (dir) {
    $('#bk-dest').val(dir);
    $tree.hide();
  });
});

$('#sm-backup').on('click', '#bk-save', function () {
  postBackup('config_set', {
    destination: $('#bk-dest').val(),
    mode: $('#bk-mode').val(),
    hour: $('#bk-hour').val(),
    minute: $('#bk-minute').val(),
    weekday: $('#bk-weekday').val(),
    dayOfMonth: $('#bk-dayofmonth').val(),
    retention: $('#bk-retention').val(),
    password: $('#bk-password').val() // blank = leave the existing password unchanged
  }, function (resp) {
    refreshBackup(resp.html);
    banner(resp.message || 'secretsman: backup settings saved', false);
  });
});

$('#sm-backup').on('click', '#bk-now', function () {
  postBackup('backup_now', {}, function (resp) {
    refreshBackup(resp.html);
    banner(resp.message || 'secretsman: backup complete', false);
  });
});

$('#sm-backup').on('click', '#bk-download', function () {
  window.location = '<?=$pluginRoot?>/scripts/backup_download.php';
});

$('#sm-backup').on('click', '#bk-restore', function () {
  var password = $('#bk-restore-password').val();
  var mode = $('input[name="bk-restore-mode"]:checked').val();
  var file = $('#bk-restore-file')[0].files[0];
  var selected = $('#bk-restore-select').val();

  if (!password) {
    $('#bk-restore-err').text('Enter the archive password.');
    return;
  }
  if (!file && !selected) {
    $('#bk-restore-err').text('Choose an existing archive or upload one.');
    return;
  }
  if (file && uploadLimitBytes && file.size > uploadLimitBytes) {
    $('#bk-restore-err').text('That archive is ' + file.size + ' bytes; this server accepts uploads up to ' + uploadLimitBytes + ' bytes (see post_max_size). Restore from a smaller archive, or place it at the configured destination and pick it from the dropdown instead.');
    return;
  }
  $('#bk-restore-err').text('');

  var text = mode === 'replace'
    ? 'This REPLACES the entire store with this archive\'s contents. Any secret not in the archive will be lost.'
    : 'This adds keys from the archive that are not already in the store. Existing keys are left untouched.';

  function doRestore(archiveB64) {
    var data = { password: password, mode: mode };
    if (archiveB64) { data.archive_b64 = archiveB64; } else { data.selected = selected; }
    postBackup('restore', data, function (resp) {
      refreshBackup(resp.html);
      refreshTableOnly(); // restored/replaced secrets must show up in the main table too, without racing the banner below (see refreshTableOnly's comment)
      var r = resp.restored;
      var msg;
      if (!r) {
        // Should never happen — the backend always includes this on a
        // successful restore — but an explicit fallback beats silence if
        // it ever does.
        msg = 'secretsman: restore completed, but no summary was returned';
      } else if (r.mode === 'replace') {
        msg = 'Restore complete: the store now holds ' + r.added.length + ' key(s)';
        if (r.removed.length) {
          msg += '; ' + r.removed.length + ' removed by the replace (' + r.removed.join(', ') + ')';
        }
        msg += '.';
      } else {
        msg = 'Restored ' + r.added.length + ' new key(s)';
        if (r.added.length) {
          msg += ' (' + r.added.join(', ') + ')';
        }
        msg += '; ' + r.collisions.length + ' already present';
        if (r.collisions.length) {
          msg += ' (' + r.collisions.join(', ') + ')';
        }
        msg += '.';
      }
      banner(msg, false);
    });
  }

  function proceed() {
    if (!file) { doRestore(null); return; }
    var reader = new FileReader();
    reader.onload = function () {
      // readAsDataURL result is "data:<mime>;base64,<data>" — strip the prefix.
      doRestore(reader.result.split(',')[1]);
    };
    reader.onerror = function () {
      banner('secretsman: could not read the selected file', true);
    };
    reader.readAsDataURL(file);
  }

  if (window.swal) {
    // The 400ms delay matters: SweetAlert v1 (bundled in dynamix.js) can
    // silently drop a swal() call made before the PREVIOUS one has finished
    // its own close animation. banner() below also opens a swal — calling
    // it immediately from this confirm's own callback raced that
    // animation and the result popup never appeared, live. Every other
    // banner() call on this page fires standalone (no preceding swal) and
    // isn't affected — restore is the only path that chains two.
    swal({ title: 'Restore from archive?', text: text, type: 'warning', showCancelButton: true, confirmButtonText: 'Restore' },
      function (ok) { if (ok) { setTimeout(proceed, 400); } });
  } else if (confirm(text)) {
    proceed();
  }
});

load();
loadBackup();
})(jQuery);
</script>
