Menu="Utilities"
Title="SecretsMan"
Icon="lock"
Tabs="false"
Markdown="false"
---
<?php
// Static shell only — no store access here at all. The table starts empty
// and is filled by a POST to scripts/store_api.php on load, which is also
// the only place that ever reads or writes the store. See CLAUDE.md
// "Phase 3" for why (single renderer, reused for every mutation).
$pluginRoot = '/plugins/unraid-secretsman';
?>
<p>
  Store secrets once, then reference them from a Docker template's Variable field with a
  token instead of typing the value in directly.
  <span id="sm-help-toggle" style="cursor:help" title="More detail">(?)</span>
</p>
<blockquote class="inline_help">
  A secret you add here is kept in one place, outside flash, instead of being duplicated in
  plaintext across every template that needs it. To use one, put <code>!secret
  &lt;namespace&gt;/&lt;key&gt;</code> in a template's Variable field <strong>in place of the
  value</strong> — for example <code>!secret myapp/api_key</code>. At container-create time
  this plugin resolves the token against the store below; the template itself, and any flash
  backup of it, only ever holds the token, never the value.
  <br><br>
  You don't need to type that syntax by hand: the <strong>Copy token</strong> button on each
  row below puts the exact string on your clipboard, ready to paste into the template field.
</blockquote>

<div id="sm-banner" class="notice" style="display:none"></div>

<form id="sm-add" onsubmit="return false">
  <table class="tablesorter shift">
    <thead><tr><th>Add a secret</th></tr></thead>
  </table>
  <table class="new">
    <tr>
      <td>Namespace</td>
      <td><input type="text" id="sm-ns" class="narrow" required pattern="[A-Za-z0-9_.-]+" placeholder="myapp"></td>
      <td>Key</td>
      <td><input type="text" id="sm-key" class="narrow" required pattern="[A-Za-z0-9_.-]+" placeholder="api_key"></td>
      <td>Value</td>
      <td>
        <span style="display:inline-flex;align-items:center;gap:0.5em">
          <input type="password" id="sm-val" required autocomplete="new-password">
          <label style="white-space:nowrap"><input type="checkbox" id="sm-show"> show</label>
        </span>
      </td>
      <td><button id="sm-addbtn" type="button">Add</button></td>
    </tr>
  </table>
  <span id="sm-adderr" class="errortext"></span>
</form>

<div id="sm-table"><p class="notice">Loading&hellip;</p></div>

<script>
(function($){
'use strict';
var API = '<?=$pluginRoot?>/scripts/store_api.php';

function banner(msg, isError) {
  var $b = $('#sm-banner');
  if (!msg) { $b.hide(); return; }
  $b.text(msg).css('color', isError ? '#c00' : '').show();
}

function refresh(html) {
  $('#sm-table').html(html);
}

function post(action, data, done) {
  data = data || {};
  data.action = action;
  $.post(API, data, function (resp) {
    if (!resp || resp.ok !== true) {
      banner((resp && resp.error) || 'secretsman: request failed', true);
      return;
    }
    banner('');
    done(resp);
  }, 'json').fail(function () {
    banner('secretsman: request failed — check the browser console', true);
  });
}

function load() {
  post('list', {}, function (resp) { refresh(resp.html); });
}

// Copies the TOKEN ("!secret ns/key"), never a value — the safe button.
function copyToken(ns, key) {
  var text = '!secret ' + ns + '/' + key;
  if (navigator.clipboard && window.isSecureContext) {
    navigator.clipboard.writeText(text);
    return;
  }
  var ta = document.createElement('textarea');
  ta.value = text;
  ta.style.position = 'fixed';
  ta.style.opacity = '0';
  document.body.appendChild(ta);
  ta.select();
  try { document.execCommand('copy'); } catch (e) {}
  document.body.removeChild(ta);
}

$('#sm-show').on('change', function () {
  $('#sm-val').attr('type', this.checked ? 'text' : 'password');
});

// Stock expandable-help convention: blockquote.inline_help is hidden by
// global CSS (default-base.css); a clickable element toggles it, same as
// e.g. dynamix/WG0.page does for its own help blocks.
$('#sm-help-toggle').on('click', function () {
  $(this).closest('p').next('blockquote.inline_help').toggle('slow');
});

$('#sm-addbtn').on('click', function () {
  var form = document.getElementById('sm-add');
  if (!form.checkValidity()) { form.reportValidity(); return; }
  var ns = $('#sm-ns').val();
  var key = $('#sm-key').val();
  var val = $('#sm-val').val();
  if (/[\r\n]/.test(val)) {
    $('#sm-adderr').text('Values cannot contain a line break — !secret values reach Docker via --env-file, which cannot carry one safely.');
    return;
  }
  $('#sm-adderr').text('');
  post('add', {ns: ns, key: key, value: val}, function (resp) {
    refresh(resp.html);
    $('#sm-ns').val(''); $('#sm-key').val(''); $('#sm-val').val(''); $('#sm-show').prop('checked', false).trigger('change');
  });
});

$('#sm-table').on('click', '.sm-reveal', function () {
  var $btn = $(this), $row = $btn.closest('tr'), $cell = $row.find('.sm-value');
  if ($btn.text() === 'Hide') {
    $cell.html($cell.data('maskHtml'));
    $btn.text('Reveal');
    return;
  }
  post('reveal', {ns: $row.data('ns'), key: $row.data('key')}, function (resp) {
    $cell.data('maskHtml', $cell.html());
    $cell.text(resp.value);
    $btn.text('Hide');
  });
});

$('#sm-table').on('click', '.sm-copy', function () {
  var $row = $(this).closest('tr');
  copyToken($row.data('ns'), $row.data('key'));
});

$('#sm-table').on('click', '.sm-add-orphan, .sm-orphans button', function () {
  $('#sm-ns').val($(this).data('ns'));
  $('#sm-key').val($(this).data('key'));
  $('#sm-val').focus();
});

$('#sm-table').on('click', '.sm-edit', function () {
  var $row = $(this).closest('tr'), $cell = $row.find('.sm-value');
  $cell.html('<input type="password" class="sm-edit-val narrow"> <button type="button" class="sm-edit-save">Save</button> <button type="button" class="sm-edit-cancel">Cancel</button>');
});

$('#sm-table').on('click', '.sm-edit-cancel', function () {
  load();
});

$('#sm-table').on('click', '.sm-edit-save', function () {
  var $row = $(this).closest('tr');
  var val = $row.find('.sm-edit-val').val();
  if (/[\r\n]/.test(val)) {
    banner('Values cannot contain a line break — !secret values reach Docker via --env-file, which cannot carry one safely.', true);
    return;
  }
  post('edit', {ns: $row.data('ns'), key: $row.data('key'), value: val}, function (resp) {
    refresh(resp.html);
  });
});

$('#sm-table').on('click', '.sm-delete', function () {
  var $row = $(this).closest('tr'), ns = $row.data('ns'), key = $row.data('key');
  var usedBy = $row.find('td:nth-child(2)').text(); // "Used by" column
  var text = 'This will permanently remove ' + ns + '/' + key + ' from the store.';
  if (usedBy && usedBy !== '—') {
    text += ' It is used by: ' + usedBy + ' — those containers will fail to start until it is restored.';
  }
  if (window.swal) {
    swal({
      title: 'Delete ' + ns + '/' + key + '?',
      text: text,
      type: 'warning',
      showCancelButton: true,
      confirmButtonText: 'Delete'
    }, function (ok) {
      if (ok) post('delete', {ns: ns, key: key}, function (resp) { refresh(resp.html); });
    });
  } else if (confirm(text)) {
    post('delete', {ns: ns, key: key}, function (resp) { refresh(resp.html); });
  }
});

load();
})(jQuery);
</script>
