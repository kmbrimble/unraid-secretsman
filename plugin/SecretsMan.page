<?php
// Thin host for the SecretsMan web app, which lives at plugins/unraid-secretsman/app/ and is served by the
// webGUI itself (same session, same CSRF). No store access and no markup of its own here: the whole UI is the
// iframe, and the same URL opens standalone via "Open full page". Menu="Tasks:91" keeps the top-bar tab.
$app = '/plugins/unraid-secretsman/app/index.php';
?>
<style>
  #sm-frame-bar { display: flex; justify-content: flex-end; margin: 0 0 6px; }
  #sm-frame { display: block; width: 100%; height: 70vh; border: 0; background: transparent; }
</style>
<div id="sm-frame-bar"><a href="<?= $app ?>" target="_blank" rel="noopener">Open full page</a></div>
<iframe id="sm-frame" title="SecretsMan" src="<?= $app ?>"></iframe>
<script>
(function () {
  'use strict';
  // Fill the viewport below the Unraid header (the app scrolls inside the frame), leaving room for the footer.
  var frame = document.getElementById('sm-frame');
  function fit() {
    var footer = document.getElementById('footer');
    var below = footer ? footer.offsetHeight : 0;
    var top = frame.getBoundingClientRect().top;
    frame.style.height = Math.max(480, window.innerHeight - top - below - 8) + 'px';
  }
  window.addEventListener('resize', fit);
  window.addEventListener('load', fit);
  fit();
})();
</script>
