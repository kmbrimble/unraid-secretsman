#!/bin/bash
# secretsman: repopulate !secretfile tmpfs sources before docker autostart.
#
# Fires on array start, once disks and user shares are mounted — strictly
# before docker_started, and therefore strictly before rc.docker's
# autostart loop ever runs. See CLAUDE.md "Array-start hook" for why this
# specific event (not docker_started) is the one with an ordering guarantee.
#
# emhttpd runs this synchronously and blocks on it (per emhttp_event's own
# header comment), which is exactly the property this depends on.
php /usr/local/emhttp/plugins/unraid-secretsman/scripts/repopulate.php
